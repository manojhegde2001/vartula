    [1, "strokeDashoffset", [[0, 95.6663], [0.142857, 95.6663, "linear(0, 0.0003, 0.0023, 0.0078, 0.0185, 0.0362, 0.0625, 0.0992, 0.1481, 0.2109, 0.2894, 0.3851, 0.5, 0.6149, 0.7106, 0.7891, 0.8519, 0.9008, 0.9375, 0.9638, 0.9815, 0.9922, 0.9977, 0.9997, 1)"], [0.828571, 0], [1, 0]]],
    [1, "fillOpacity", [[0, 0.6], [0.142857, 0.6, "cubic-bezier(0.75, 0, 0.75, 0.9)"], [0.428571, 0], [1, 0]]],
    [2, "fillOpacity", [[0, 1], [0.085714, 1, "cubic-bezier(0.75, 0, 0.75, 0.9)"], [0.371429, 0], [1, 0]]],
    [3, "strokeDashoffset", [[0, 43.065], [0.314286, 43.065, "linear(0, 0.0003, 0.0023, 0.0078, 0.0185, 0.0362, 0.0625, 0.0992, 0.1481, 0.2109, 0.2894, 0.3851, 0.5, 0.6149, 0.7106, 0.7891, 0.8519, 0.9008, 0.9375, 0.9638, 0.9815, 0.9922, 0.9977, 0.9997, 1)"], [1, 0]]],
    [3, "fillOpacity", [[0, 1], [0.028571, 1, "cubic-bezier(0.75, 0, 0.75, 0.9)"], [0.314286, 0], [1, 0]]]
  ];
  svg.style.background = "#ffffff";
  dash.forEach(function (value, index) {
