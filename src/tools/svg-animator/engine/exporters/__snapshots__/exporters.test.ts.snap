"// Vartula SVG Animator (GSAP 3)
// Load GSAP first: <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
// Paste the SVG from the "SVG" tab into your page, then run this script.
(function () {
  const svg = document.querySelector(".vartula-svg");
  if (!svg) return;
  const el = function (i) { return svg.querySelector(".vt-" + i); };
  // CSS cubic-bezier timing function
  const bezier = function (x1, y1, x2, y2) {
    const f = function (t, a, b) { return 3 * a * t * (1 - t) * (1 - t) + 3 * b * t * t * (1 - t) + t * t * t; };
    return function (x) {
      let lo = 0, hi = 1, t = x;
      for (let i = 0; i < 30; i++) { if (f(t, x1, x2) < x) lo = t; else hi = t; t = (lo + hi) / 2; }
      return f(t, y1, y2);
    };
  };
  const cssEaseReversed = bezier(0.75, 0, 0.75, 0.9);
  gsap.set(svg, { background: "#ffffff" });
  const tl = gsap.timeline();
  tl.set(el(0), { strokeDasharray: "80.8 80.8", strokeDashoffset: 81.204, fillOpacity: 0.5 }, 0);
  tl.fromTo(el(0), { strokeDashoffset: 81.204 }, { strokeDashoffset: 0, duration: 1.2, ease: "power2.inOut", immediateRender: false }, 0.1);
  tl.fromTo(el(0), { fillOpacity: 0.5 }, { fillOpacity: 0, duration: 0.5, ease: cssEaseReversed, immediateRender: false }, 0.35);
  tl.set(el(1), { strokeDasharray: "95.1903 95.1903", strokeDashoffset: 95.6663, fillOpacity: 0.6 }, 0);
  tl.fromTo(el(1), { strokeDashoffset: 95.6663 }, { strokeDashoffset: 0, duration: 1.2, ease: "power2.inOut", immediateRender: false }, 0.25);
  tl.fromTo(el(1), { fillOpacity: 0.6 }, { fillOpacity: 0, duration: 0.5, ease: cssEaseReversed, immediateRender: false }, 0.25);
  tl.set(el(2), { fillOpacity: 1 }, 0);
  tl.fromTo(el(2), { fillOpacity: 1 }, { fillOpacity: 0, duration: 0.5, ease: cssEaseReversed, immediateRender: false }, 0.15);
  tl.set(el(3), { strokeDasharray: "42.8507 42.8507", strokeDashoffset: 43.065, fillOpacity: 1 }, 0);
  tl.fromTo(el(3), { strokeDashoffset: 43.065 }, { strokeDashoffset: 0, duration: 1.2, ease: "power2.inOut", immediateRender: false }, 0.55);
  tl.fromTo(el(3), { fillOpacity: 1 }, { fillOpacity: 0, duration: 0.5, ease: cssEaseReversed, immediateRender: false }, 0.05);
  // Pad the timeline to the full loop length.
  tl.set({}, {}, 1.75);
  window.vartulaTimeline = tl;
})();
